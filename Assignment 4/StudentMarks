
import java.util.Scanner;

class StudentMarks {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter marks of vineet: ");
        String mark1 = sc.nextLine();

        System.out.print("Enter marks of vyom: ");
        String mark2 = sc.nextLine();

        System.out.print("Enter marks of vishnu: ");
        String mark3 = sc.nextLine();

        Integer m1 = Integer.valueOf(mark1);
        Integer m2 = Integer.valueOf(mark2);
        Integer m3 = Integer.valueOf(mark3);

        int total = m1 + m2 + m3;

        System.out.println("Marks of vineet : " + m1);
        System.out.println("Marks of vyom: " + m2);
        System.out.println("Marks of vishnu: " + m3);
        System.out.println("Total marks: " + total);

        sc.close();
    }
}
